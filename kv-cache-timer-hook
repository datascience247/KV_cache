#!/usr/bin/env bash
set -euo pipefail

session="${CLAUDE_CODE_SESSION_ID:-default}"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_DIR="${XDG_STATE_HOME}/kv-cache-timer"
CONFIG_FILE="${CONFIG_FILE:-${XDG_CONFIG_HOME}/kv-cache-timer/config.sh}"

# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"

TTL=$(( ${TTL:-300} ))
TS_FILE="${TS_FILE:-${CACHE_DIR}/ts_${session}}"

mkdir -p "$CACHE_DIR"

printf '%s' "$(date +%s)" > "$TS_FILE"

cleanup_min=$(( (TTL + 59) / 60 ))
find "$CACHE_DIR" -maxdepth 1 -name 'ts_*' -mmin +"$cleanup_min" -delete 2>/dev/null || true
