#!/usr/bin/env bash
session="${CLAUDE_CODE_SESSION_ID:-default}"

# Clear notification sentinel so the next cooling cycle can notify again
rm -f "${HOME}/.claude_cache_notified_${session}"

# Write current timestamp
date +%s > "${HOME}/.claude_cache_ts_${session}"

# Clean stale files (>60 min old)
find "${HOME}" -maxdepth 1 \( -name '.claude_cache_ts_*' -o -name '.claude_cache_notified_*' \) -mmin +60 -delete 2>/dev/null || true
