#!/usr/bin/env bash
set -euo pipefail

session="${CLAUDE_CODE_SESSION_ID:-default}"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_DIR="${XDG_STATE_HOME}/kv-cache-timer"
CONFIG_FILE="${CONFIG_FILE:-${XDG_CONFIG_HOME}/kv-cache-timer/config.sh}"

# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"

TS_FILE="${TS_FILE:-${CACHE_DIR}/ts_${session}}"
TTL=$(( ${TTL:-300} ))
SHOW_BAR=$(( ${SHOW_BAR:-0} ))
BAR_WIDTH=$(( ${BAR_WIDTH:-10} ))

exit_cold() {
  printf '❄ COLD\n'
  exit 0
}

[[ -f "$TS_FILE" ]] || exit_cold

last=$(< "$TS_FILE")
last="${last//[[:space:]]/}"

[[ "$last" =~ ^[0-9]+$ ]] || exit_cold

now=$(date +%s)
remaining=$(( TTL - (now - last) ))

(( remaining > TTL )) && remaining=$TTL
(( remaining <= 0 )) && exit_cold

mins=$(( remaining / 60 ))
secs=$(( remaining % 60 ))
time_str=$(printf "%d:%02d" "$mins" "$secs")

if (( SHOW_BAR == 1 )); then
  total_pos=$(( BAR_WIDTH * 8 ))
  filled_pos=$(( remaining * total_pos / TTL ))
  (( filled_pos > total_pos )) && filled_pos=$total_pos
  full_blocks=$(( filled_pos / 8 ))
  partial=$(( filled_pos % 8 ))
  partial_chars=(" " "▏" "▎" "▍" "▌" "▋" "▊" "▉")
  bar=""
  for (( i=0; i<BAR_WIDTH; i++ )); do
    if (( i < full_blocks )); then
      bar+="█"
    elif (( i == full_blocks )) && (( partial > 0 )); then
      bar+="${partial_chars[$partial]}"
    else
      bar+=" "
    fi
  done
  printf '🔥 HOT [%s] %s\n' "$bar" "$time_str"
else
  printf '🔥 HOT %s\n' "$time_str"
fi
