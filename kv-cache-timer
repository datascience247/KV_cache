#!/usr/bin/env bash
session="${CLAUDE_CODE_SESSION_ID:-default}"

# Load user config (CONFIG_FILE env var can override; /dev/null disables it)
CONFIG_FILE="${CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/kv-cache-timer/config.sh}"
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"

# Defaults — env vars take priority over config file values
TS_FILE="${TS_FILE:-$HOME/.claude_cache_ts_${session}}"
NOTIFY_FILE="${NOTIFY_FILE:-$HOME/.claude_cache_notified_${session}}"
TTL="${TTL:-300}"
SHOW_BAR="${SHOW_BAR:-0}"
BAR_WIDTH="${BAR_WIDTH:-10}"
NOTIFY_THRESHOLD="${NOTIFY_THRESHOLD:-60}"
SHOW_COLOR="${SHOW_COLOR:-0}"
if [ "${SHOW_COLOR}" = "1" ] && [ -z "${NO_COLOR:-}" ]; then
  C_HOT="\033[38;5;208m"; C_COLD="\033[34m"; C_RESET="\033[0m"
else
  C_HOT=""; C_COLD=""; C_RESET=""
fi

[ ! -f "$TS_FILE" ] && printf "${C_COLD}❄ COLD${C_RESET}\n" && exit 0

last=$(cat "$TS_FILE")
last="${last//[[:space:]]/}"
if ! [[ "$last" =~ ^[0-9]+$ ]]; then
  printf "${C_COLD}❄ COLD${C_RESET}\n"
  exit 0
fi

now=$(date +%s)
remaining=$(( TTL - (now - last) ))
[ "$remaining" -gt "$TTL" ] && remaining=$TTL

if [ "$remaining" -le 0 ]; then
  printf "${C_COLD}❄ COLD${C_RESET}\n"
  exit 0
fi

# Desktop notification when crossing into warning zone — fires once per cooling cycle
if [ "${NOTIFY_THRESHOLD}" -gt 0 ] && [ "$remaining" -le "${NOTIFY_THRESHOLD}" ] && [ ! -f "$NOTIFY_FILE" ]; then
  touch "$NOTIFY_FILE"
  if command -v notify-send &>/dev/null; then
    notify-send -u normal "KV Cache" "Cache expires in ~${remaining}s" >/dev/null 2>&1 &
  elif command -v terminal-notifier &>/dev/null; then
    terminal-notifier -title "KV Cache" -message "Cache expires in ~${remaining}s" >/dev/null 2>&1 &
  elif [[ "$OSTYPE" == darwin* ]]; then
    osascript -e "display notification \"Cache expires in ~${remaining}s\" with title \"KV Cache\"" >/dev/null 2>&1 &
  fi
fi

mins=$(( remaining / 60 ))
secs=$(( remaining % 60 ))
time_str=$(printf "%d:%02d" "$mins" "$secs")

if [ "${SHOW_BAR}" = "1" ]; then
  total_pos=$(( BAR_WIDTH * 8 ))
  filled_pos=$(( remaining * total_pos / TTL ))
  [ "$filled_pos" -gt "$total_pos" ] && filled_pos=$total_pos
  full_blocks=$(( filled_pos / 8 ))
  partial=$(( filled_pos % 8 ))
  partial_chars=("░" "▏" "▎" "▍" "▌" "▋" "▊" "▉")
  bar=""
  for (( i=0; i<BAR_WIDTH; i++ )); do
    if [ "$i" -lt "$full_blocks" ]; then
      bar+="█"
    elif [ "$i" -eq "$full_blocks" ] && [ "$partial" -gt 0 ]; then
      bar+="${partial_chars[$partial]}"
    else
      bar+="░"
    fi
  done
  printf "${C_HOT}🔥 HOT [${bar}] ${time_str}${C_RESET}\n"
else
  printf "${C_HOT}🔥 HOT ${time_str}${C_RESET}\n"
fi
